# `pnpm check` before anything leaves the laptop: the static checks and the unit tests with
# coverage, as CI. The build and the e2e tests (they need the app's env vars) stay in CI.
#
# Load nvm if it is around, so the hook does not fail just because the shell
# git was launched from had an older Node than .nvmrc (see the commit-msg hook).
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
  nvm use >/dev/null 2>&1 || true
fi

major="$(node -v | sed 's/^v//' | cut -d. -f1)"
if [ "$major" -lt 22 ]; then
  echo "pre-push hook: Node >= 22 required, got $(node -v). Run 'nvm use' (see .nvmrc)."
  exit 1
fi

# A branch that only changes docs (*.md, docs/) since origin/main runs only the docs checks, as CI.
base="$(git merge-base HEAD origin/main 2>/dev/null || true)"
if [ -n "$base" ] && bash scripts/only-docs-changed.sh "$base"; then
  echo "pre-push: only docs changed since origin/main; running the docs checks only."
  pnpm format:check && exec pnpm check:docs
fi

pnpm check
